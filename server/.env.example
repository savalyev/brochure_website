PORT=3000
# 127.0.0.1 — если сервер за nginx на той же машине (наружу Node не торчит)
HOST=127.0.0.1
# loopback — доверять X-Forwarded-For только от локального nginx (по умолчанию)
TRUST_PROXY=loopback
FRONTEND_ORIGIN=https://proverkarest.ru

EMAIL_HOST=smtp.yandex.ru
EMAIL_PORT=465
EMAIL_USER=
# пароль приложения Яндекса, не основной пароль от ящика
EMAIL_PASS=
EMAIL_TO=
